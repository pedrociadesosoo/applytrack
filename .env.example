# --- Supabase (Phase 1) ---------------------------------------------------
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used only in server-side API routes; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google OAuth (Phase 3: sign-in + read-only Gmail sync) -------------
# Same OAuth client you pasted into Supabase -> Authentication -> Google.
# Sign-in itself is handled by Supabase; the server needs these to refresh
# Gmail access tokens during sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude API (later: classify emails the rules can't, follow-ups) -----
# ANTHROPIC_API_KEY=sk-ant-...
